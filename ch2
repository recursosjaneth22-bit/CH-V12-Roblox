	espBoxesButton.Text = espBoxes and "⬜  Boxes  •  ON" or "⬜  Boxes  •  OFF"
	if espEnabled then for plr in pairs(ESP) do createESP(plr) end end
end)

hitboxButton.MouseButton1Click:Connect(function()
