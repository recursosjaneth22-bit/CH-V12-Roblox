local function ensureHitboxFolder()
	if hitboxFolder and hitboxFolder.Parent then return end
	hitboxFolder = Instance.new("Folder")
	hitboxFolder.Name = "CH_Hitboxes"
	hitboxFolder.Parent = workspace
end

local function clearHitboxes()
	if hitboxFolder then
		hitboxFolder:ClearAllChildren()
	end
end

RunService.Heartbeat:Connect(function()
	if not hitboxEnabled then
		clearHitboxes()
		return
	end

	ensureHitboxFolder()

	local active = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if isValidTarget(plr) and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				active[plr] = true
				local box = hitboxFolder:FindFirstChild("HB_" .. plr.UserId)
				if not box then
					box = Instance.new("Part")
					box.Name = "HB_" .. plr.UserId
					box.Anchored = true
					box.CanCollide = false
					box.CanQuery = true
					box.CanTouch = false
					box.Material = Enum.Material.ForceField
					box.Color = COLOR_ENEMY
					box.Parent = hitboxFolder
				end
				box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
				box.Transparency = hitboxTransparency
				box.CFrame = hrp.CFrame
			end
		end
	end

	-- limpiar de jugadores que ya no aplican
	for _, box in ipairs(hitboxFolder:GetChildren()) do
		local id = tonumber(box.Name:match("HB_(%d+)"))
		local plr = id and Players:GetPlayerByUserId(id)
		if not plr or not active[plr] then
			box:Destroy()
		end
	end
end)

task.spawn(function()
	while gui.Parent do
		if espEnabled then updateESP() end
		task.wait(0.4)
	end
end)

