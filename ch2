UserInputService.InputBegan:Connect(function(input, processed)
	if waitingMenuKey and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			MenuKey = input.KeyCode
			waitingMenuKey = false
			keyButton.Text = "⌨  Tecla  •  " .. MenuKey.Name
		end
		return
	end
	if processed then return end
	if input.KeyCode == MenuKey then
		if menu.Visible then setMenuVisible(false, false) else setMenuVisible(true, false) end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if activeSlider and isMoveInput(input) then
		activeSlider.update(input.Position.X)
		return
	end
	if draggingMenu and isMoveInput(input) then
		local delta = input.Position - dragStart
		menu.Position = UDim2.new(menuStart.X.Scale, menuStart.X.Offset + delta.X, menuStart.Y.Scale, menuStart.Y.Offset + delta.Y)
		return
	end
	if draggingBall and isMoveInput(input) then
		local delta = input.Position - ballDragStart
		if delta.Magnitude > 8 then ballMoved = true end
		floatingButton.Position = UDim2.new(ballStart.X.Scale, ballStart.X.Offset + delta.X, ballStart.Y.Scale, ballStart.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if isDragInput(input) then
		draggingMenu = false
		draggingBall = false
		activeSlider = nil
	end
end)

