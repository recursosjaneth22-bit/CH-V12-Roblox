		pcall(function()
			if typeof(line) == "Instance" then
				line.Visible = false
			else
				line.Visible = false
			end
		end)
	end
end

local function newScreenLine()
	local f = Instance.new("Frame")
	f.Name = "Line"
	f.BackgroundColor3 = ESP_RED
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(0, 2)
	f.Visible = false
	f.ZIndex = 50
	f.Parent = drawFolder
	return f
end

local function setScreenLine(line, from, to)
	if not line or not from or not to then
		if line then line.Visible = false end
		return
	end
	local dx = to.X - from.X
	local dy = to.Y - from.Y
	local len = math.sqrt(dx*dx + dy*dy)
	if len < 1 then
		line.Visible = false
		return
	end
	line.Visible = true
	line.BackgroundColor3 = ESP_RED
	line.Size = UDim2.fromOffset(math.max(len, 1), 2)
	line.Position = UDim2.fromOffset((from.X + to.X) * 0.5, (from.Y + to.Y) * 0.5)
	line.Rotation = math.deg(math.atan2(dy, dx))
end

local function destroySkeleton(data)
	if not data then return end
	removeDrawLines(data.skelLines)
	removeDrawLines(data.boxLines)
	removeDrawLines(data.headLines)
	data.skelLines = nil
	data.boxLines = nil
	data.headLines = nil
	data.skelBones = nil
end

local function clearAllESP()
	for plr, data in pairs(ESP) do
		if data.highlight then pcall(function() data.highlight:Destroy() end) end
