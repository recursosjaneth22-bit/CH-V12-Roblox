local function isFriend(plr)

    if not ignoreFriends
        or not plr then

        return false
    end

    local ok, result =
        pcall(function()

            return LocalPlayer:IsFriendsWith(
                plr.UserId
            )

        end)

    return ok and result == true
end

local function isSameTeam(plr)

    if not ignoreTeam
        or not plr
        or plr == LocalPlayer then

        return false
    end

    if LocalPlayer.Team
        and plr.Team then

        return LocalPlayer.Team ==
            plr.Team
    end

    return false
end

local function shouldTarget(plr)

    if not plr
        or plr == LocalPlayer then

        return false
    end

    if isFriend(plr) then
        return false
    end

    if isSameTeam(plr) then
        return false
    end

    return true
end

