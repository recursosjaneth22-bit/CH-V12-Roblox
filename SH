local function saveGraphics(obj, property)
    if not savedGraphics[obj] then savedGraphics[obj] = {} end
    if savedGraphics[obj][property] == nil then
        pcall(function() savedGraphics[obj][property] = obj[property] end)
    end
end

local function setGraphicsProperty(obj, property, value)
    pcall(function()
        saveGraphics(obj, property)
        obj[property] = value
    end)
end

local function makeObjectUgly(obj)
    if obj:IsA("Decal") or obj:IsA("Texture") then
        setGraphicsProperty(obj, "Transparency", 1)
        return
    end
    if obj:IsA("SurfaceAppearance") then
        setGraphicsProperty(obj, "Parent", nil)
        return
    end
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
        setGraphicsProperty(obj, "Enabled", false)
        return
    end
    if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        setGraphicsProperty(obj, "Enabled", false)
        return
    end
    if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("DepthOfFieldEffect") or obj:IsA("SunRaysEffect") then
        setGraphicsProperty(obj, "Enabled", false)
        return
    end
    if obj:IsA("Atmosphere") then
        setGraphicsProperty(obj, "Density", 0)
        setGraphicsProperty(obj, "Haze", 0)
        setGraphicsProperty(obj, "Glare", 0)
        return
    end
    if obj:IsA("BasePart") then
        setGraphicsProperty(obj, "CastShadow", false)
        setGraphicsProperty(obj, "Material", Enum.Material.SmoothPlastic)
        setGraphicsProperty(obj, "Reflectance", 0)
        return
    end
end

