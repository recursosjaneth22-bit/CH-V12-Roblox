-- Solo queda ignorar amigos de Roblox (fiable).
function isFriend(plr)
	if not ignoreFriends or not plr then return false end
	local id = plr.UserId
	local now = os.clock()
	if friendCacheTime[id] and now - friendCacheTime[id] < 10 then
		return friendCache[id] == true
	end
	local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(id) end)
	friendCache[id] = ok and res or false
	friendCacheTime[id] = now
	return friendCache[id]
end

function shouldTarget(plr)
	if not plr or plr == LocalPlayer then return false end
	if ignoreFriends and isFriend(plr) then
		return false
	end
	-- Team de Roblox SOLO si el juego realmente lo usa (casi nunca aquí)
	if plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team then
		return false
	end
	return true
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function pointInsidePart(worldPos, part)
	if not worldPos or not part then return false end
	local localPos = part.CFrame:PointToObjectSpace(worldPos)
	local half = part.Size * 0.5
	-- margen pequeño para no fallar en el borde
	return math.abs(localPos.X) <= half.X + 0.15
		and math.abs(localPos.Y) <= half.Y + 0.15
		and math.abs(localPos.Z) <= half.Z + 0.15
end

local function isEnemyUnderCrosshair()
	local function resolveCharacter(hit)
		if not hit then return nil end
		if hit.Name == "CH_VisibleHitbox" then return hit.Parent end
		return hit:FindFirstAncestorOfClass("Model")
	end
	local function checkCharacter(character)
		if not character then return false end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return false end
		return shouldTarget(Players:GetPlayerFromCharacter(character))
	end

	if checkCharacter(resolveCharacter(Mouse.Target)) then return true end

	local cam = workspace.CurrentCamera
	if cam then
		if Character then
			rayParams.FilterDescendantsInstances = {Character}
		else
			rayParams.FilterDescendantsInstances = {}
		end
		local vp = cam.ViewportSize
		local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		local result = workspace:Raycast(ray.Origin, ray.Direction * 1500, rayParams)
		if result and checkCharacter(resolveCharacter(result.Instance)) then return true end
	end

	-- HITBOX: dentro del cuadro O mirando al cuadro (antes fallaba solo estando dentro)
	if HitboxEnabled and HitboxSize > 0 then
		local camPos = cam and cam.CFrame.Position or nil
		for _, plr in ipairs(Players:GetPlayers()) do
			if shouldTarget(plr) and plr.Character then
				local char = plr.Character
				local hrp = char:FindFirstChild("HumanoidRootPart")
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local hb = char:FindFirstChild("CH_VisibleHitbox")
					-- 1) Estás DENTRO de la hitbox (tu root o la cámara)
					if hb then
						if Root and pointInsidePart(Root.Position, hb) then
							return true
						end
						if camPos and pointInsidePart(camPos, hb) then
							return true
						end
					else
						-- sin part visual: esfera/caja por distancia al HRP
						if Root and (Root.Position - hrp.Position).Magnitude <= (HitboxSize * 0.55) then
							return true
						end
						if camPos and (camPos - hrp.Position).Magnitude <= (HitboxSize * 0.55) then
							return true
						end
					end
					-- 2) Fuera pero dentro del rango y mirando hacia el enemigo
					if Root and cam then
						local dist = (Root.Position - hrp.Position).Magnitude
						if dist <= (HitboxSize * 0.85) then
							local dir = (hrp.Position - cam.CFrame.Position)
							if dir.Magnitude > 0.01 then
								if cam.CFrame.LookVector:Dot(dir.Unit) > 0.55 then
									return true
								end
							end
						end
					end
				end
			end
		end
	end
	return false
end


