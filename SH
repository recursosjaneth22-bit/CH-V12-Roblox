local function RemoveHitbox(char)
	if not char then return end
	local old = char:FindFirstChild("CH_VisibleHitbox")
	if old then old:Destroy() end
end

local function CreateHitbox(char)
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	RemoveHitbox(char)
	if not HitboxEnabled or HitboxSize <= 0 then return end
	local visual = Instance.new("Part")
	visual.Name = "CH_VisibleHitbox"
	visual.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
	visual.CFrame = hrp.CFrame
	visual.Transparency = HitboxVisible and 0.65 or 1
	visual.Color = Color3.fromRGB(40, 40, 45)
	visual.Material = Enum.Material.ForceField
	visual.Anchored = false
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = true
	visual.Massless = true
	visual.CastShadow = false
	visual.Parent = char
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = visual
	weld.Parent = visual
end

function UpdateAllHitboxes()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then CreateHitbox(plr.Character) end
	end
end

function RemoveAllHitboxes()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then RemoveHitbox(plr.Character) end
	end
end

local function SetupPlayer(plr)
	if plr == LocalPlayer then return end
	local function onChar(char)
		task.wait(0.4)
		if HitboxEnabled then CreateHitbox(char) end
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
		if hum then
			local killPlayed = false
			local function tryKill()
				if killPlayed or not killSoundEnabled then return end
				if wasMyKill(hum, plr) then
					killPlayed = true
					playKillSfx(char)
				end
			end
			hum.Died:Connect(function() RemoveHitbox(char) tryKill() end)
			hum.HealthChanged:Connect(function(hp)
				if hp <= 0 then RemoveHitbox(char) tryKill() end
			end)
		end
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then task.spawn(onChar, plr.Character) end
	plr.CharacterRemoving:Connect(function(char) RemoveHitbox(char) end)
end
for _, plr in ipairs(Players:GetPlayers()) do SetupPlayer(plr) end
Players.PlayerAdded:Connect(SetupPlayer)

local function isFriend(plr)
	if not ignoreFriends or not plr then return false end
	local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end)
	return ok and res
end

local function shouldTarget(plr)
	if not plr or plr == LocalPlayer then return false end
	if isFriend(plr) then return false end
	return true
end

local function isEnemyUnderCrosshair()
	local function resolveCharacter(hit)
		if not hit then return nil end
		if hit.Name == "CH_VisibleHitbox" then return hit.Parent end
		return hit:FindFirstAncestorOfClass("Model")
	end
	local function checkCharacter(character)
		if not character then return false end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return false end
		return shouldTarget(Players:GetPlayerFromCharacter(character))
	end
	local cam = workspace.CurrentCamera
	if cam then
		local vp = cam.ViewportSize
		local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if Character then params.FilterDescendantsInstances = {Character} end
		params.IgnoreWater = true
		local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
		if result and checkCharacter(resolveCharacter(result.Instance)) then return true end
	end
	if checkCharacter(resolveCharacter(Mouse.Target)) then return true end
	if Root and HitboxEnabled and HitboxSize > 0 then
		for _, plr in ipairs(Players:GetPlayers()) do
			if shouldTarget(plr) and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local dist = (Root.Position - hrp.Position).Magnitude
					if dist <= (HitboxSize * 0.75) then
						local cam2 = workspace.CurrentCamera
						if cam2 then
							local dir = (hrp.Position - cam2.CFrame.Position).Unit
							if cam2.CFrame.LookVector:Dot(dir) > 0.75 then return true end
						end
					end
				end
			end
		end
	end
	return false
end

