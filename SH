    button.MouseLeave:Connect(function()
        if not indicator.Visible then
            animate(selectedBg, 0.18, { BackgroundTransparency = 1 })
            animate(label, 0.18, { TextColor3 = Theme.SubText })
        end
    end)

    return button
end

