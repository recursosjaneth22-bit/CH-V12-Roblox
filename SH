local function markShotTarget()
	lastShotTime = os.clock()
	lastAnyShotTime = os.clock()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if Character then params.FilterDescendantsInstances = {Character} end
	local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if result and result.Instance then
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local plr = Players:GetPlayerFromCharacter(model)
			if plr and plr ~= LocalPlayer then lastShotTarget = plr end
		end
	end
end

local function wasMyKill(hum, deadPlayer)
	local tag = hum:FindFirstChild("creator") or hum:FindFirstChild("Creator")
	if tag then
		local v = tag.Value
		if v == LocalPlayer then return true end
		if typeof(v) == "Instance" and v:IsA("Player") and v == LocalPlayer then return true end
		if typeof(v) == "Instance" and v:IsA("Model") and Players:GetPlayerFromCharacter(v) == LocalPlayer then return true end
	end
	if deadPlayer and lastShotTarget == deadPlayer and (os.clock() - lastShotTime) < 6 then return true end
	if (os.clock() - lastAnyShotTime) < 4 and Root and deadPlayer and deadPlayer.Character then
		local dr = deadPlayer.Character:FindFirstChild("HumanoidRootPart")
		if dr and (Root.Position - dr.Position).Magnitude < 180 then return true end
	end
	return false
end

