local function createToggle(
    parent,
    y,
    title,
    description,
    initial,
    callback
)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -20, 0, 46)
    holder.Position = UDim2.fromOffset(10, y)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    createLabel(
        holder,
        title,
        0,
        2,
        250,
        18,
        10,
        Theme.Text
    )

    createLabel(
        holder,
        description,
        0,
        22,
        290,
        16,
        8,
        Theme.SubText
    )

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(48, 24)
    button.Position = UDim2.new(1, -48, 0, 8)
    button.BackgroundColor3 =
        initial and Theme.Accent or Theme.Track
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = holder

    addCorner(button, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Position =
        initial
        and UDim2.new(1, -21, 0.5, -9)
        or UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = Theme.White
    knob.BorderSizePixel = 0
    knob.Parent = button

    addCorner(knob, 9)

    local state = initial

    local function setState(value, callCallback)
        state = value == true

        animate(
            button,
            0.14,
            {
                BackgroundColor3 =
                    state
                    and Theme.Accent
                    or Theme.Track
            }
        )

        animate(
            knob,
            0.14,
            {
                Position =
                    state
                    and UDim2.new(
                        1,
                        -21,
                        0.5,
                        -9
                    )
                    or UDim2.fromOffset(
                        3,
                        3
                    )
            }
        )

        if callCallback and callback then
            callback(state)
        end
    end

    button.MouseButton1Click:Connect(function()
        setState(not state, true)
    end)

    return {
        Set = function(_, value)
            setState(value, false)
        end,

        Get = function()
            return state
        end,

        Button = button
    }
end

