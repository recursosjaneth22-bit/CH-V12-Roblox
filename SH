--==================== CONFIG GUARDADA (writefile/readfile) ====================
local CONFIG_FILE = "CH_PC_Config_" .. tostring(LocalPlayer.UserId) .. ".json"
local configLoaded = false
local configSaveQueued = false

local function keyToName(k)
	if typeof(k) == "EnumItem" then return k.Name end
	return tostring(k)
end

local function nameToKey(name)
	if type(name) ~= "string" then return nil end
	local ok, k = pcall(function() return Enum.KeyCode[name] end)
	if ok and k then return k end
	return nil
end

local function saveConfig()
	if typeof(writefile) ~= "function" then
		warn("[CH] writefile no disponible en este executor")
		return false
	end
	local data = {
		version = 2,
		MenuKey = keyToName(MenuKey),
		TriggerKey = keyToName(TriggerKey),
		HitboxKey = keyToName(HitboxKey),
		AimbotKey = keyToName(AimbotKey),
		aimbotEnabled = aimbotEnabled,
		aimFovCursor = aimFovCursor,
		aimSmoothCursor = aimSmoothCursor,
		aimOnShoot = aimOnShoot,
		aimOnAds = aimOnAds,
		lastTriggerDelay = lastTriggerDelay,
		ignoreFriends = ignoreFriends,
		ignoreTeam = ignoreTeam,
		espEnabled = espEnabled,
		espNames = espNames,
		espHealth = espHealth,
		espDistance = espDistance,
		espBoxes = espBoxes,
		espSkeleton = espSkeleton,
		espBox2D = espBox2D,
		HitboxEnabled = HitboxEnabled,
		HitboxVisible = HitboxVisible,
		HitboxSize = HitboxSize,
		jumpSoundEnabled = jumpSoundEnabled,
		killSoundEnabled = killSoundEnabled,
		runDefaultEnabled = runDefaultEnabled,
		runMuteEnabled = runMuteEnabled,
		jumpVolume = jumpVolume,
		killVolume = killVolume,
		selectedKillSound = selectedKillSound,
		lowTexturesEnabled = lowTexturesEnabled,
	}
	local ok, err = pcall(function()
		writefile(CONFIG_FILE, HttpService:JSONEncode(data))
	end)
	if ok then
		print("[CH] Config guardada → " .. CONFIG_FILE)
		return true
	end
	warn("[CH] No se pudo guardar config: " .. tostring(err))
	return false
end

local function queueSaveConfig()
	if configSaveQueued then return end
	configSaveQueued = true
	task.delay(0.35, function()
		configSaveQueued = false
		saveConfig()
	end)
end

local function loadConfig()
	if typeof(readfile) ~= "function" then
		warn("[CH] readfile no disponible")
		return false
	end
	local exists = true
	if typeof(isfile) == "function" then
		local okE, res = pcall(isfile, CONFIG_FILE)
		exists = okE and res == true
	end
	if not exists then
		print("[CH] Sin config guardada (" .. CONFIG_FILE .. ")")
		return false
	end
	local ok, raw = pcall(readfile, CONFIG_FILE)
	if not ok or type(raw) ~= "string" or raw == "" then
		warn("[CH] Error leyendo config")
		return false
	end
	local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then
		warn("[CH] Config inválida")
		return false
	end

	local mk = nameToKey(data.MenuKey); if mk then MenuKey = mk end
	local tk = nameToKey(data.TriggerKey); if tk then TriggerKey = tk end
	local hk = nameToKey(data.HitboxKey); if hk then HitboxKey = hk end
	local ak = nameToKey(data.AimbotKey); if ak then AimbotKey = ak end
	if data.aimbotEnabled ~= nil then aimbotEnabled = data.aimbotEnabled == true end
	if type(data.aimFovCursor) == "number" then aimFovCursor = data.aimFovCursor end
	if type(data.aimSmoothCursor) == "number" then aimSmoothCursor = data.aimSmoothCursor end
	if data.aimOnShoot ~= nil then aimOnShoot = data.aimOnShoot == true end
	if data.aimOnAds ~= nil then aimOnAds = data.aimOnAds == true end

	if type(data.lastTriggerDelay) == "number" then
		lastTriggerDelay = math.clamp(data.lastTriggerDelay, 0.02, 0.15)
	end
	if data.ignoreFriends ~= nil then ignoreFriends = data.ignoreFriends == true end
	if data.ignoreTeam ~= nil then ignoreTeam = data.ignoreTeam == true end
	if data.espEnabled ~= nil then espEnabled = data.espEnabled == true end
	if data.espNames ~= nil then espNames = data.espNames == true end
	if data.espHealth ~= nil then espHealth = data.espHealth == true end
	if data.espDistance ~= nil then espDistance = data.espDistance == true end
	if data.espBoxes ~= nil then espBoxes = data.espBoxes == true end
	if data.espSkeleton ~= nil then espSkeleton = data.espSkeleton == true end
	if data.espBox2D ~= nil then espBox2D = data.espBox2D == true end
	if data.HitboxEnabled ~= nil then HitboxEnabled = data.HitboxEnabled == true end
	if data.HitboxVisible ~= nil then HitboxVisible = data.HitboxVisible == true end
	if type(data.HitboxSize) == "number" then HitboxSize = math.clamp(data.HitboxSize, 1, 40) end
	if data.jumpSoundEnabled ~= nil then jumpSoundEnabled = data.jumpSoundEnabled == true end
	if data.killSoundEnabled ~= nil then killSoundEnabled = data.killSoundEnabled == true end
	if data.runDefaultEnabled ~= nil then runDefaultEnabled = data.runDefaultEnabled == true end
	if data.runMuteEnabled ~= nil then runMuteEnabled = data.runMuteEnabled == true end
	if type(data.jumpVolume) == "number" then jumpVolume = math.clamp(data.jumpVolume, 0, 2) end
	if type(data.killVolume) == "number" then killVolume = math.clamp(data.killVolume, 0, 2) end
	if type(data.selectedKillSound) == "number" then
		selectedKillSound = math.clamp(math.floor(data.selectedKillSound), 1, #KILL_SOUNDS)
		KILL_SOUND_ID = KILL_SOUNDS[selectedKillSound].id
	end
	if data.lowTexturesEnabled ~= nil then lowTexturesEnabled = data.lowTexturesEnabled == true end

	configLoaded = true
	print("[CH] Config cargada ← " .. CONFIG_FILE)
	return true
end

