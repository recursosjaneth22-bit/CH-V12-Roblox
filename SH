local function applyLocalRunSettings(char)
	if not char or char ~= LocalPlayer.Character then return end
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end
	local run = hrp:FindFirstChild("Running")
	if run and run:IsA("Sound") then
		if run.Volume > 0.05 and not runMuteEnabled then
			savedRunVolume = run.Volume
		end
		if runMuteEnabled then
			run.Volume = 0
		else
			-- Restaurar pasos
			run.Volume = (savedRunVolume > 0 and savedRunVolume) or 0.65
			run.Playing = false -- el motor lo vuelve a poner al caminar
		end
	end
	local jump = hrp:FindFirstChild("Jumping")
	if jump and jump:IsA("Sound") then
		jump.Volume = 0
	end
end

function applyDefaultSoundReplace(char)
	if char == LocalPlayer.Character then
		applyLocalRunSettings(char)
	end
end

