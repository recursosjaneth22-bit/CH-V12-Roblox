local function isOurSound(s)
	if not s then return true end
	if s.Parent == gui then return true end
	local n = tostring(s.Name)
	if n:find("^CH_") or n:find("CH_Jump") or n:find("CH_Kill") then return true end
	-- no silenciar nuestros kill IDs
	local sid = tostring(s.SoundId)
	for _, info in ipairs(KILL_SOUNDS) do
		if sid:find(info.id:gsub("rbxassetid://", "")) then return true end
	end
	return false
end

local function silenceSound(s)
	if not s or not s:IsA("Sound") then return end
	if isOurSound(s) then return end
	pcall(function()
		s.Volume = 0
		s:Stop()
		s.Playing = false
	end)
end

local function soundLooksLikeDeath(s)
	local n = string.lower(tostring(s.Name) .. " " .. tostring(s.SoundId))
	for _, kw in ipairs(KEYWORDS_DEATH) do
		if n:find(kw) then return true end
	end
	return false
end

local function muteGameDeathSounds(deadChar)
	-- ligero: solo personaje muerto + hijos de SoundService (sin scan de workspace)
	local function scanLight(root)
		if not root then return end
		for _, d in ipairs(root:GetChildren()) do
			if d:IsA("Sound") then
				if soundLooksLikeDeath(d) or d.Playing then
					silenceSound(d)
				end
			end
		end
		-- un nivel más en el muerto
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Sound") and (soundLooksLikeDeath(d) or d.Playing) then
				silenceSound(d)
			end
		end
	end
	pcall(function() scanLight(deadChar) end)
	pcall(function()
		local ss = game:GetService("SoundService")
		for _, d in ipairs(ss:GetChildren()) do
			if d:IsA("Sound") and (soundLooksLikeDeath(d) or d.Playing) then
				silenceSound(d)
			end
		end
	end)
end

