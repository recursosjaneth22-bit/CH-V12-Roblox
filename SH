UserInputService.InputBegan:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if waitingTriggerKey and input.KeyCode ~= Enum.KeyCode.Unknown then
			TriggerKey = input.KeyCode waitingTriggerKey = false triggerKeyValue.Text = TriggerKey.Name return
		end
		if waitingHitboxKey and input.KeyCode ~= Enum.KeyCode.Unknown then
			HitboxKey = input.KeyCode waitingHitboxKey = false hitboxKeyValue.Text = HitboxKey.Name return
		end
		if waitingMenuKey and input.KeyCode ~= Enum.KeyCode.Unknown then
			MenuKey = input.KeyCode waitingMenuKey = false menuKeyValue.Text = MenuKey.Name return
		end
		if waitingTeleportKey and input.KeyCode ~= Enum.KeyCode.Unknown then
			TeleportKey = input.KeyCode waitingTeleportKey = false tpKeyValue.Text = TeleportKey.Name return
		end
		if waitingDownClipKey and input.KeyCode ~= Enum.KeyCode.Unknown then
			DownClipKey = input.KeyCode waitingDownClipKey = false downClipKeyValue.Text = DownClipKey.Name return
		end
	end
	if input.KeyCode == DownClipKey then isHoldingDown = true end
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then markShotTarget() end
	if input.KeyCode == TriggerKey then
		triggerbotEnabled = not triggerbotEnabled
		triggerToggle:Set(triggerbotEnabled)
		triggerStatus.Text = triggerbotEnabled and "Activado" or "Desactivado"
		playToggleSound(triggerbotEnabled)
	elseif input.KeyCode == HitboxKey then
		HitboxEnabled = not HitboxEnabled
		hitboxToggle:Set(HitboxEnabled)
		hitboxStatus.Text = HitboxEnabled and "Activado" or "Desactivado"
		playToggleSound(HitboxEnabled)
		if HitboxEnabled then UpdateAllHitboxes() else RemoveAllHitboxes() end
	elseif input.KeyCode == TeleportKey then
		doTeleport()
	elseif input.KeyCode == MenuKey then
		if streamerMode then streamerMode = false setMenuVisible(true, false)
		else setMenuVisible(not menu.Visible, false) end
	end
end)

