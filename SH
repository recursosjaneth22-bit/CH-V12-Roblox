--==================================================
-- GRÁFICOS SYSTEM
--==================================================

local function saveGraphics(obj, property)
    if not savedGraphics[obj] then savedGraphics[obj] = {} end
    if savedGraphics[obj][property] == nil then
        pcall(function() savedGraphics[obj][property] = obj[property] end)
    end
end

local function setGraphicsProperty(obj, property, value)
    pcall(function()
        saveGraphics(obj, property)
        obj[property] = value
    end)
end

local function makeObjectUgly(obj)
    if obj:IsA("Decal") or obj:IsA("Texture") then
        setGraphicsProperty(obj, "Transparency", 1)
        return
    end
    if obj:IsA("SurfaceAppearance") then
        setGraphicsProperty(obj, "Parent", nil)
        return
    end
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
        setGraphicsProperty(obj, "Enabled", false)
        return
    end
    if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        setGraphicsProperty(obj, "Enabled", false)
        return
    end
    if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("DepthOfFieldEffect") or obj:IsA("SunRaysEffect") then
        setGraphicsProperty(obj, "Enabled", false)
        return
    end
    if obj:IsA("Atmosphere") then
        setGraphicsProperty(obj, "Density", 0)
        setGraphicsProperty(obj, "Haze", 0)
        setGraphicsProperty(obj, "Glare", 0)
        return
    end
    if obj:IsA("BasePart") then
        setGraphicsProperty(obj, "CastShadow", false)
        setGraphicsProperty(obj, "Material", Enum.Material.SmoothPlastic)
        setGraphicsProperty(obj, "Reflectance", 0)
        return
    end
end

local function enableLowGraphics()
    if lowGraphicsEnabled then return end
    table.clear(savedGraphics)
    setGraphicsProperty(Lighting, "GlobalShadows", false)
    setGraphicsProperty(Lighting, "EnvironmentDiffuseScale", 0)
    setGraphicsProperty(Lighting, "EnvironmentSpecularScale", 0)
    for _, obj in ipairs(workspace:GetDescendants()) do makeObjectUgly(obj) end
    for _, obj in ipairs(Lighting:GetDescendants()) do makeObjectUgly(obj) end
    lowGraphicsEnabled = true
    graphicsStatus.Text = "Activado • rendimiento prioritario"
    playToggleSound(true)
end

local function disableLowGraphics()
    if not lowGraphicsEnabled then return end
    for obj, properties in pairs(savedGraphics) do
        if obj then
            for property, oldValue in pairs(properties) do
                pcall(function()
                    if property == "Parent" then
                        if oldValue then obj.Parent = oldValue end
                    else
                        obj[property] = oldValue
                    end
                end)
            end
        end
    end
    table.clear(savedGraphics)
    lowGraphicsEnabled = false
    graphicsStatus.Text = "Desactivado"
    playToggleSound(false)
end

local graphicsToggle = createToggle(graphicsMain, 0, "", "", false, function(on)
    if on then enableLowGraphics() else disableLowGraphics() end
