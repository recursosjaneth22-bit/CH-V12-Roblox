local savedRunVolume = 0.65

local function muteGameDeathSounds(deadChar)
	local keywords = {"death", "die", "kill", "elim", "dead", "muerte", "oof", "lose"}
	local function silence(s)
		if s and s:IsA("Sound") then
			pcall(function()
				s.Volume = 0
				s:Stop()
			end)
		end
	end
	local function scan(root)
		if not root then return end
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Sound") then
				local n = string.lower(d.Name .. " " .. tostring(d.SoundId))
				for _, kw in ipairs(keywords) do
					if n:find(kw) then silence(d) break end
				end
			end
		end
	end
	if deadChar then scan(deadChar) end
	pcall(function() scan(game:GetService("SoundService")) end)
	if Character then scan(Character) end
end

