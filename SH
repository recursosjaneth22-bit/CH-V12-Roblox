local recentShotTargets = {} -- [Player] = os.clock()

local function rememberTarget(plr)
	if not plr or plr == LocalPlayer then return end
	lastShotTarget = plr
	lastShotTime = os.clock()
	lastAnyShotTime = os.clock()
	recentShotTargets[plr] = os.clock()
end

local function markShotTarget()
	lastAnyShotTime = os.clock()
	local cam = workspace.CurrentCamera

	-- 1) Mouse.Target (cursor libre)
	if Mouse.Target then
		local model = Mouse.Target:FindFirstAncestorOfClass("Model")
		if model then
			local plr = Players:GetPlayerFromCharacter(model)
			if plr then rememberTarget(plr) end
		end
	end

	if not cam then return end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if Character then params.FilterDescendantsInstances = { Character } end
	params.IgnoreWater = true

	-- 2) Ray desde el cursor
	local mousePos = UserInputService:GetMouseLocation()
	local mouseRay = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
	local r1 = workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 5000, params)
	if r1 and r1.Instance then
		local model = r1.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local plr = Players:GetPlayerFromCharacter(model)
			if plr then rememberTarget(plr) end
		end
	end

	-- 3) Ray centro (primera persona / ADS)
	local vp = cam.ViewportSize
	local centerRay = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	local r2 = workspace:Raycast(centerRay.Origin, centerRay.Direction * 5000, params)
	if r2 and r2.Instance then
		local model = r2.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local plr = Players:GetPlayerFromCharacter(model)
			if plr then rememberTarget(plr) end
		end
	end
end

local function wasMyKill(hum, deadPlayer)
	-- 1) creator tag del juego (la forma más fiable)
	if hum then
		for _, name in ipairs({ "creator", "Creator", "KillCreator", "LastHit", "attacker", "Attacker" }) do
			local tag = hum:FindFirstChild(name)
			if tag then
				local v = tag.Value
				if v == LocalPlayer then return true end
				if typeof(v) == "Instance" then
					if v:IsA("Player") and v == LocalPlayer then return true end
					if v:IsA("Model") and Players:GetPlayerFromCharacter(v) == LocalPlayer then return true end
					if v:IsA("ObjectValue") and v.Value == LocalPlayer then return true end
				end
				if tostring(v) == tostring(LocalPlayer.UserId) or tostring(v) == LocalPlayer.Name then
					return true
				end
			end
		end
		-- atributos
		for _, an in ipairs({ "creator", "Creator", "LastAttacker", "KilledBy" }) do
			local av = hum:GetAttribute(an) or (deadPlayer and deadPlayer:GetAttribute(an))
			if av ~= nil then
				if av == LocalPlayer.UserId or av == LocalPlayer.Name or av == LocalPlayer then
					return true
				end
			end
		end
	end

	-- 2) Le diste a ESTE jugador hace poco (sirve de lejos, sin límite de distancia)
	if deadPlayer and lastShotTarget == deadPlayer and (os.clock() - lastShotTime) < 10 then
		return true
	end
	if deadPlayer and recentShotTargets[deadPlayer] and (os.clock() - recentShotTargets[deadPlayer]) < 10 then
		return true
	end

	-- NO usamos "murió cerca mío" → eso hacía sonar kills del equipo
	return false
end

