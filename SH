--==================================================
-- SLIDER
--==================================================

local function createSlider(
    parent,
    y,
    title,
    min,
    max,
    value,
    callback
)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -20, 0, 55)
    holder.Position = UDim2.fromOffset(10, y)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = title .. tostring(value)
    label.TextColor3 = Theme.Text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 9
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, 0, 0, 6)
    bar.Position = UDim2.fromOffset(0, 31)
    bar.BackgroundColor3 = Theme.Track
    bar.BorderSizePixel = 0
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = holder

    addCorner(bar, 4)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar

    addCorner(fill, 4)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Theme.White
    knob.BorderSizePixel = 0
    knob.Parent = bar

    addCorner(knob, 6)

    local slider = {
        value = value,
        update = nil
    }

    local function update(x)

        local width = bar.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local percent = math.clamp(
            (x - bar.AbsolutePosition.X) / width,
            0,
            1
        )

        local newValue = math.floor(
            min + (max - min) * percent + 0.5
        )

        slider.value = newValue

        label.Text =
            title .. tostring(newValue)

        fill.Size =
            UDim2.new(
                percent,
                0,
                1,
                0
            )

        knob.Position =
            UDim2.new(
                percent,
                0,
                0.5,
                0
            )

        if callback then
            callback(newValue)
        end
    end

    slider.update = update

    bar.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            activeSlider = slider

            update(
                input.Position.X
            )
        end
    end)

    task.defer(function()

        local percent =
            math.clamp(
                (value - min) / (max - min),
                0,
                1
            )

        update(
            bar.AbsolutePosition.X
            + bar.AbsoluteSize.X * percent
        )
    end)

    return slider
end

