	end)
end

-- Correr: default Roblox O silenciar (solo MI personaje)
-- Importante: NO usar Stop() al silenciar, o luego no vuelve
local function applyLocalRunSettings(char)
	if not char or char ~= LocalPlayer.Character then return end
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end
	local run = hrp:FindFirstChild("Running")
	if run and run:IsA("Sound") then
		if run.Volume > 0.05 and not runMuteEnabled then
			savedRunVolume = run.Volume
		end
		if runMuteEnabled then
			run.Volume = 0
		else
			-- Restaurar pasos
			run.Volume = (savedRunVolume > 0 and savedRunVolume) or 0.65
			run.Playing = false -- el motor lo vuelve a poner al caminar
		end
	end
	local jump = hrp:FindFirstChild("Jumping")
	if jump and jump:IsA("Sound") then
		jump.Volume = 0
	end
end

function applyDefaultSoundReplace(char)
	if char == LocalPlayer.Character then
		applyLocalRunSettings(char)
	end
end

-- Mantener mute/default del correr en mi personaje
RunService.Heartbeat:Connect(function()
	if not Character or not Root then return end
	local run = Root:FindFirstChild("Running")
	if run and run:IsA("Sound") then
		if runMuteEnabled then
			if run.Volume ~= 0 then run.Volume = 0 end
		else
			-- Si el juego dejó el volumen en 0, restaurarlo para que se oigan otra vez
			if run.Volume <= 0.01 then
				run.Volume = (savedRunVolume > 0 and savedRunVolume) or 0.65
			else
				savedRunVolume = run.Volume
			end
		end
	end
end)

-- Salto custom para TODOS los jugadores (lo oyes tú)
local function playJumpFor(plr)
	if not jumpSoundEnabled or not plr then return end
	local now = os.clock()
	if lastJumpByPlayer[plr] and (now - lastJumpByPlayer[plr]) < 0.3 then return end
	lastJumpByPlayer[plr] = now
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = JUMP_SOUND_ID
		s.Volume = math.clamp(jumpVolume, 0, 2)
		s.Parent = gui
		s:Play()
		s.Ended:Connect(function() s:Destroy() end)
		task.delay(2, function() if s and s.Parent then s:Destroy() end end)
	end)
end

local function hookJumpOnCharacter(plr, char)
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if not hum then return end
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			playJumpFor(plr)
		end
	end)
end

local function hookPlayerSounds(plr)
	plr.CharacterAdded:Connect(function(char)
		task.wait(0.3)
		hookJumpOnCharacter(plr, char)
