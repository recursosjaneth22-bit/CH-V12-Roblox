--==================== LOGICA ====================
local function RemoveHitbox(char)
	if not char then return end
	local old = char:FindFirstChild("CH_VisibleHitbox")
	if old then old:Destroy() end
end

local function CreateHitbox(char)
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	RemoveHitbox(char)
	if not HitboxEnabled or HitboxSize <= 0 then return end
	local visual = Instance.new("Part")
	visual.Name = "CH_VisibleHitbox"
	visual.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
	visual.CFrame = hrp.CFrame
	visual.Transparency = (HitboxVisible and not streamerMode) and 0.65 or 1
	visual.Color = Color3.fromRGB(40, 40, 45)
	visual.Material = Enum.Material.ForceField
	visual.Anchored = false
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = true
	visual.Massless = true
	visual.CastShadow = false
	visual.Parent = char
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = visual
	weld.Parent = visual
end

function UpdateAllHitboxes()
	if not isInMatch() then
		RemoveAllHitboxes()
		return
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			-- shouldTarget puede filtrar equipo cuando exista
			if shouldTarget and not shouldTarget(plr) then
				RemoveHitbox(plr.Character)
			else
				CreateHitbox(plr.Character)
			end
		end
	end
end

function RemoveAllHitboxes()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then RemoveHitbox(plr.Character) end
	end
end

local function SetupPlayer(plr)
	if plr == LocalPlayer then return end
	local function onChar(char)
		task.wait(0.4)
		if HitboxEnabled and isInMatch() then CreateHitbox(char) end
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
		if hum then
			local function tryKill()
				if not killSoundEnabled then return end
				-- debounce por jugador (antes solo sonaba 1 vez y se trababa)
				if not _killSfxAt then _killSfxAt = {} end
				local id = plr.UserId
				local now = os.clock()
				if _killSfxAt[id] and (now - _killSfxAt[id]) < 2.0 then return end
				_killSfxAt[id] = now
				playKillSfx(char)
			end
			hum.Died:Connect(function()
				RemoveHitbox(char)
				tryKill()
			end)
			local lastHp = hum.Health
			hum.HealthChanged:Connect(function(hp)
				if hp <= 0 and lastHp > 0 then
					RemoveHitbox(char)
					tryKill()
				end
				lastHp = hp
			end)
		end
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then task.spawn(onChar, plr.Character) end
	plr.CharacterRemoving:Connect(function(char) RemoveHitbox(char) end)
end
for _, plr in ipairs(Players:GetPlayers()) do SetupPlayer(plr) end
Players.PlayerAdded:Connect(SetupPlayer)

