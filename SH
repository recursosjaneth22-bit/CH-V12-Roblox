local function doTeleport()
	if isTeleporting or not selectedPlayer or not Root then return end
	if not selectedPlayer.Character then return end
	local targetRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot then return end
	isTeleporting = true
	local offset = targetRoot.CFrame.LookVector * -6
	local targetPos = targetRoot.Position + offset + Vector3.new(0, 2, 0)
	local startPos = Root.Position
	task.spawn(function()
		for i = 1, 10 do
			if not Root or not Root.Parent then break end
			Root.CFrame = CFrame.new(startPos:Lerp(targetPos, i / 10))
			task.wait(0.025)
		end
		if Root and Root.Parent then Root.CFrame = CFrame.new(targetPos) end
		isTeleporting = false
		playToggleSound(true)
	end)
end

