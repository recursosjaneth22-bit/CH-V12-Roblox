    addCorner(indicator, 2)
    addGradient(indicator, Theme.AccentLight, Theme.AccentDark, 90)

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.fromOffset(30, 44)
    iconLabel.Position = UDim2.fromOffset(10, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon
    iconLabel.TextSize = 16
    iconLabel.Parent = button

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.fromOffset(42, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.SubText
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    navButtons[name] = {
        Button = button,
        Indicator = indicator,
        Label = label,
        SelectedBg = selectedBg,
        Icon = iconLabel
    }

    -- Hover suave
    button.MouseEnter:Connect(function()
        if not indicator.Visible then
            animate(selectedBg, 0.18, { BackgroundTransparency = 0.6 })
            animate(label, 0.18, { TextColor3 = Theme.Text })
