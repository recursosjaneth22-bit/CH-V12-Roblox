UserInputService.InputBegan:Connect(function(input, processed)
    if waitingTriggerKey and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            TriggerKey = input.KeyCode
            waitingTriggerKey = false
            triggerKeyValue.Text = TriggerKey.Name
        end
        return
    end

    if waitingMenuKey and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            MenuKey = input.KeyCode
            waitingMenuKey = false
            menuKeyValue.Text = MenuKey.Name
        end
        return
    end

    if processed then return end

    if input.KeyCode == TriggerKey then
        triggerbotEnabled = not triggerbotEnabled
        triggerToggle:Set(triggerbotEnabled)
        triggerStatus.Text = triggerbotEnabled and "Activado" or "Desactivado"
        triggerStatusDot.BackgroundColor3 = triggerbotEnabled and Theme.Green or Theme.Muted
        triggerStatusText.Text = triggerbotEnabled and "Funcionando" or "Listo para activar"
        triggerStatusText.TextColor3 = triggerbotEnabled and Theme.Green or Theme.Muted
        playToggleSound(triggerbotEnabled)
        return
    end

    if input.KeyCode == MenuKey then
        if streamerMode then
            streamerMode = false
            setMenuVisible(true, false)
        else
            setMenuVisible(not menu.Visible, false)
        end
    end
end)

