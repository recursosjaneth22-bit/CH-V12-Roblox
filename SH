local function getCursorAimTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local mousePos = UserInputService:GetMouseLocation()
	local best, bestD = nil, aimFovCursor
	for _, plr in ipairs(Players:GetPlayers()) do
		if shouldTarget(plr) then
			local char = plr.Character
			if char then
				local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
				local hum = char:FindFirstChildOfClass("Humanoid")
				if part and hum and hum.Health > 0 then
					local sp, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen and sp.Z > 0 then
						local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
						if d <= bestD then
							bestD = d
							best = part
						end
					end
				end
			end
		end
	end
	return best
end

local function moveCursorTo(worldPart)
	local cam = workspace.CurrentCamera
	if not cam or not worldPart then return end
	local sp, onScreen = cam:WorldToViewportPoint(worldPart.Position)
	if not onScreen or sp.Z <= 0 then return end
	local mousePos = UserInputService:GetMouseLocation()
	local dx = sp.X - mousePos.X
	local dy = sp.Y - mousePos.Y
	local alpha = math.clamp(1 - aimSmoothCursor, 0.08, 1)
	dx, dy = dx * alpha, dy * alpha
	if math.abs(dx) < 0.15 and math.abs(dy) < 0.15 then return end
	-- SOLO cursor — no tocar Camera.CFrame
	if mousemoverel then
		pcall(function() mousemoverel(dx, dy) end)
		return
	end
	pcall(function()
		local vim = game:GetService("VirtualInputManager")
		local pos = UserInputService:GetMouseLocation()
		vim:SendMouseMoveEvent(pos.X + dx, pos.Y + dy, game)
	end)
end

