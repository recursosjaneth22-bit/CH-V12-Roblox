local function createToggle(parent, y, title, description, initial, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -20, 0, 48)
    holder.Position = UDim2.fromOffset(10, y)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    createLabel(holder, title, 0, 3, 250, 18, 11, Theme.Text)
    createLabel(holder, description, 0, 23, 290, 16, 8, Theme.SubText)

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(50, 26)
    button.Position = UDim2.new(1, -50, 0, 8)
    button.BackgroundColor3 = initial and Theme.Accent or Theme.Track
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = holder

    addCorner(button, 13)
    addStroke(button, 0.2, 1, initial and Theme.AccentDark or Theme.TrackLight)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(20, 20)
    knob.Position = initial and UDim2.new(1, -23, 0.5, -10) or UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = Theme.White
    knob.BorderSizePixel = 0
    knob.Parent = button

    addCorner(knob, 10)
    addStroke(knob, 0.3, 1, Theme.StrokeLight)

    local state = initial

    local function setState(value, callCallback)
        state = value == true

        animate(button, 0.16, {
            BackgroundColor3 = state and Theme.Accent or Theme.Track
        })

        animate(knob, 0.18, {
            Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.fromOffset(3, 3)
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        if callCallback and callback then
            callback(state)
        end
    end

    button.MouseButton1Click:Connect(function()
        setState(not state, true)
    end)

    return {
        Set = function(_, value) setState(value, false) end,
        Get = function() return state end,
        Button = button
    }
end

