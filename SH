		end
	end
end

local R15_BONES = {
	{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
local R6_BONES = {
	{"Head", "Torso"},
	{"Torso", "Left Arm"}, {"Torso", "Right Arm"},
	{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function worldToScreen(cam, pos)
	local v, onScreen = cam:WorldToViewportPoint(pos)
	if v.Z <= 0 then return nil end
	local vs = cam.ViewportSize
	if v.X < -150 or v.Y < -150 or v.X > vs.X + 150 or v.Y > vs.Y + 150 then
		return nil
	end
	return Vector2.new(v.X, v.Y), onScreen
end

local function updatePlayerDrawings(data)
	if not data then return end
	local char = data.character
	if not char or not char.Parent then
		hideDrawLines(data.skelLines)
		hideDrawLines(data.boxLines)
		hideDrawLines(data.headLines)
		return
	end
	local hum = data.humanoid
	if hum and hum.Health <= 0 then
		hideDrawLines(data.skelLines)
		hideDrawLines(data.boxLines)
		hideDrawLines(data.headLines)
		return
	end
	if streamerMode or not espEnabled then
		hideDrawLines(data.skelLines)
		hideDrawLines(data.boxLines)
		hideDrawLines(data.headLines)
		return
	end

	local cam = workspace.CurrentCamera
	if not cam then
		hideDrawLines(data.skelLines)
		hideDrawLines(data.boxLines)
		hideDrawLines(data.headLines)
		return
	end

	-- ESQUELETO
	if espSkeleton then
		if not data.skelLines then
			local bones = R15_BONES
			if char:FindFirstChild("Torso") and not char:FindFirstChild("UpperTorso") then
				bones = R6_BONES
			end
			data.skelBones = bones
			data.skelLines = {}
			for _ = 1, #bones do
				table.insert(data.skelLines, newScreenLine())
			end
		end
		local bones = data.skelBones or R15_BONES
		for i, pair in ipairs(bones) do
			local line = data.skelLines[i]
			local a = char:FindFirstChild(pair[1])
			local b = char:FindFirstChild(pair[2])
			local sa = (a and a:IsA("BasePart")) and worldToScreen(cam, a.Position) or nil
			local sb = (b and b:IsA("BasePart")) and worldToScreen(cam, b.Position) or nil
			setScreenLine(line, sa, sb)
		end
		-- Cabeza (cruz)
		local head = char:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			if not data.headLines then
				data.headLines = { newScreenLine(), newScreenLine() }
			end
			local hp = worldToScreen(cam, head.Position)
			if hp then
				local s = 6
				setScreenLine(data.headLines[1], Vector2.new(hp.X - s, hp.Y), Vector2.new(hp.X + s, hp.Y))
				setScreenLine(data.headLines[2], Vector2.new(hp.X, hp.Y - s), Vector2.new(hp.X, hp.Y + s))
			else
				hideDrawLines(data.headLines)
			end
		else
			hideDrawLines(data.headLines)
		end
	else
		hideDrawLines(data.skelLines)
		hideDrawLines(data.headLines)
	end

	-- CAJA 2D (más chica)
	if espBox2D then
		if not data.boxLines then
			data.boxLines = {}
			for _ = 1, 4 do
				table.insert(data.boxLines, newScreenLine())
			end
		end
		local root = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		if root then
			-- caja compacta basada en HRP + cabeza (no armas/accesorios)
			local height = 5.2
			local width = 2.2
			local depth = 2.2
			if head then
				height = math.clamp((root.Position.Y - head.Position.Y) + 4.2, 4, 7)
			end
			local cf = root.CFrame
			local hs = Vector3.new(width * 0.5, height * 0.5, depth * 0.5)
			local corners = {}
			for _, ox in ipairs({ -1, 1 }) do
				for _, oy in ipairs({ -1, 1 }) do
					for _, oz in ipairs({ -1, 1 }) do
						local wp = (cf * CFrame.new(hs.X * ox, hs.Y * oy * 0.9, hs.Z * oz)).Position
						local sp = worldToScreen(cam, wp)
						if sp then table.insert(corners, sp) end
					end
				end
			end
			if #corners >= 2 then
				local minX, minY = corners[1].X, corners[1].Y
				local maxX, maxY = minX, minY
				for _, p in ipairs(corners) do
					if p.X < minX then minX = p.X end
					if p.Y < minY then minY = p.Y end
					if p.X > maxX then maxX = p.X end
					if p.Y > maxY then maxY = p.Y end
				end
				local pts = {
					Vector2.new(minX, minY), Vector2.new(maxX, minY),
					Vector2.new(maxX, maxY), Vector2.new(minX, maxY),
				}
				local edges = {{1,2},{2,3},{3,4},{4,1}}
				for i, e in ipairs(edges) do
					setScreenLine(data.boxLines[i], pts[e[1]], pts[e[2]])
				end
			else
				hideDrawLines(data.boxLines)
			end
		else
			hideDrawLines(data.boxLines)
		end
	else
		hideDrawLines(data.boxLines)
	end
end

