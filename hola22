	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(1, -60, 0, 16)
	sub.Position = UDim2.fromOffset(0, 26)
	sub.BackgroundTransparency = 1
	sub.Text = desc
	sub.TextColor3 = Theme.SubText
	sub.Font = Enum.Font.Gotham
	sub.TextSize = 10
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.Parent = holder

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(48, 26)
	btn.Position = UDim2.new(1, -48, 0.5, -13)
	btn.BackgroundColor3 = initial and Theme.Accent or Theme.Track
	btn.Text = ""
	btn.Parent = holder
	addCorner(btn, 13)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(20, 20)
	knob.Position = initial and UDim2.new(1, -23, 0.5, -10) or UDim2.fromOffset(3, 3)
	knob.BackgroundColor3 = Theme.White
	knob.Parent = btn
	addCorner(knob, 10)

	local state = initial
	btn.MouseButton1Click:Connect(function()
		state = not state
		animate(btn, 0.15, {BackgroundColor3 = state and Theme.Accent or Theme.Track})
		animate(knob, 0.15, {Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.fromOffset(3, 3)})
		if callback then callback(state) end
	end)

	return {
		Set = function(_, v)
			state = v
			btn.BackgroundColor3 = state and Theme.Accent or Theme.Track
			knob.Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.fromOffset(3, 3)
		end
	}
end

